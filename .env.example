    "session": "main_watcher",
    "api_id": 12345,
    "api_hash": "hash1",
    "role": "watcher"
  },
  {
    "session": "commenter1",
    "api_id": 12346,
    "api_hash": "hash2",
    "role": "commenter"
  },
  {
    "session": "commenter2",
    "api_id": 12347,
