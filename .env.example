# Telegram API
API_ID=your_api_id
API_HASH=your_api_hash

# Каналы для мониторинга (через запятую)
CHANNELS=@channel1,@channel2,@channel3

# Лог канал
LOG_CHANNEL=@your_log_channel

# AI
OPENAI_API_KEY=your_openai_key
AI_MODEL=gpt-4o-mini

# Настройки
MIN_POST_LENGTH=40
COMMENT_PROBABILITY=0.8
DIALOG_PROBABILITY=0.2
GIF_PROBABILITY=0.2

ROOT_COMMENTS_MIN=1
ROOT_COMMENTS_MAX=3

POST_DELAY_MIN=10
POST_DELAY_MAX=20

BETWEEN_COMMENTS_MIN=50
BETWEEN_COMMENTS_MAX=70

COMMENT_GENERATION_TRIES=8

ACCOUNTS_JSON=[
